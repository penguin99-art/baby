# Optional OpenAI-compatible LLM API. Never commit real keys.
LLM_BASE_URL=https://api.example.com
LLM_API_KEY=replace-me
LLM_MODEL=your-chat-model

# Optional embedding API. If BASE_URL/API_KEY are omitted, LLM values are reused.
EMBEDDING_BASE_URL=https://api.example.com
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=your-embedding-model

# Optional local server port.
PORT=8000

# Optional isolated data directory (accounts, conversations, knowledge, setup token).
# Keep it private and outside source control when overriding this path.
# BABY_DATA_DIR=/absolute/path/to/private/baby-data
